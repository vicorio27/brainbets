# BrainBets Environment Configuration
# Copy this file to .env and fill in your actual values.
# .env is gitignored and must NEVER be committed.

# =============================================================================
# TELEGRAM (required for bot + notifications)
# =============================================================================
# Bot token from @BotFather: https://t.me/botfather
TELEGRAM_TOKEN=your_telegram_bot_token
# Chat ID from @userinfobot or https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =============================================================================
# PREDICTION ENRICHMENT / SPORTS DATA PROVIDERS
# =============================================================================
# OpenAI (GPT-4o-mini reasoning enrichment in the prediction engine)
OPENAI_API_KEY=your_openai_api_key
# RapidAPI (football fixtures/odds fallback provider)
RAPIDAPI_KEY=your_rapidapi_key
# api-tennis.com (tennis fixtures, odds, results, statistics)
TENNIS_API_KEY=your_api_tennis_key
# football-data.org (primary football fixtures; free tier for top leagues)
FOOTBALL_DATA_ORG_TOKEN=your_football_data_org_token

# =============================================================================
# INTERNAL API
# =============================================================================
# Guards all /api/v1/internal/* endpoints (n8n <-> backend). Any long random string.
INTERNAL_API_KEY=change-me-internal-key

# =============================================================================
# N8N (local dev defaults shown; override for non-local deployments)
# =============================================================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=brainbets123
