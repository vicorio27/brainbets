{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchesFile",
  "description": "Schema for the matches JSON file generated by n8n Data Collection Pipeline",
  "type": "object",
  "required": ["generatedAt", "tennis", "football"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the file was generated"
    },
    "tennis": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["matchId", "player1", "player2", "tournament", "eventDate"],
        "properties": {
          "matchId": { "type": "string" },
          "player1": { "type": "string" },
          "player2": { "type": "string" },
          "tournament": { "type": "string" },
          "eventDate": { "type": "string", "format": "date" },
          "eventTime": { "type": "string" },
          "rankingPlayer1": { "type": "integer" },
          "rankingPlayer2": { "type": "integer" },
          "surface": { "type": "string" },
          "formPlayer1": { "type": "string" },
          "formPlayer2": { "type": "string" },
          "h2h": { "type": "string" },
          "acesAvgPlayer1": { "type": "number" },
          "acesAvgPlayer2": { "type": "number" }
        }
      }
    },
    "football": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["matchId", "homeTeam", "awayTeam", "league", "eventDate"],
        "properties": {
          "matchId": { "type": "string" },
          "homeTeam": { "type": "string" },
          "awayTeam": { "type": "string" },
          "league": { "type": "string" },
          "eventDate": { "type": "string", "format": "date" },
          "eventTime": { "type": "string" },
          "homePosition": { "type": "integer" },
          "awayPosition": { "type": "integer" },
          "homeForm": { "type": "string" },
          "awayForm": { "type": "string" },
          "homeXg": { "type": "number" },
          "awayXg": { "type": "number" },
          "homeCorners": { "type": "number" },
          "awayCorners": { "type": "number" }
        }
      }
    }
  }
}
