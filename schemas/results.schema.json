{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResultsFile",
  "description": "Schema for the results JSON file generated by n8n Validation Pipeline",
  "type": "object",
  "required": ["generatedAt", "results"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predictionId", "success", "actualResult", "validationReason"],
        "properties": {
          "predictionId": { "type": "string" },
          "success": { "type": "boolean" },
          "actualResult": { "type": "string" },
          "validationReason": { "type": "string" },
          "matchScore": { "type": "string" }
        }
      }
    }
  }
}
