{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PredictionsFile",
  "description": "Schema for the predictions JSON file generated by n8n Prediction Pipeline",
  "type": "object",
  "required": ["generatedAt", "predictions"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predictionId", "matchId", "sport", "market", "prediction", "confidence", "reasoning", "status"],
        "properties": {
          "predictionId": { "type": "string" },
          "matchId": { "type": "string" },
          "sport": { "type": "string", "enum": ["tennis", "football"] },
          "market": { "type": "string" },
          "prediction": { "type": "string" },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "reasoning": { "type": "string" },
          "status": { "type": "string", "enum": ["PENDING", "VALIDATED", "FAILED"] }
        }
      }
    }
  }
}
