      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/update-scores-football",
        "sendBody": false,
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"Content-Type\": \"application/json\"}",
        "options": {
          "timeout": 180000
