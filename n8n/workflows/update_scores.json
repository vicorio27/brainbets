      },
      "id": "update-football",
      "name": "Update Football",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/update-scores-tennis",
        "sendBody": false,
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"Content-Type\": \"application/json\"}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "update-tennis",
      "name": "Update Tennis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const football = $('Update Football').first().json || {};\nconst tennis = $('Update Tennis').first().json || {};\nconst footballText = football.message || 'Futbol sin datos';\nconst tennisText = tennis.message || 'Tenis sin datos';\nconst avg = Math.round(((football.overallAvgFulfillment || 0) + (tennis.overallAvgFulfillment || 0)) / 2);\nconst errors = (football.errors || 0) + (tennis.errors || 0);\nconst message = `<b>BrainBets - Progreso en Vivo</b>\\n\\n${footballText}\\n${tennisText}\\n\\nAvg fulfillment: ${avg}%\\nErrores: ${errors}`;\nreturn [{ json: { message: message, football: football, tennis: tennis, avgFulfillment: avg, errors: errors } }];"
      },
      "id": "prepare-response",
      "name": "Prepare Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot__TELEGRAM_TOKEN__/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "chat_id": "__TELEGRAM_CHAT_ID__",
          "text": "={{ $json.message }}",
          "parse_mode": "HTML"
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"Content-Type\": \"application/json\"}"
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
