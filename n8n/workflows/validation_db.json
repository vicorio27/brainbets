{
  "id": "validation_db",
  "name": "BrainBets - Validation Pipeline DB-First",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "validation-db",
        "responseMode": "lastNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "validation-db"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst query = input.query || {};\nconst raw = (query.sport || '').toLowerCase();\nconst sport = raw === 'football' ? 'football' : raw === 'tennis' ? 'tennis' : 'all';\nreturn [{ json: { sport: sport } }];"
      },
      "id": "set-sport",
      "name": "Set Sport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/update-scores-football",
        "sendBody": false,
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"Content-Type\": \"application/json\"}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "update-football-first",
      "name": "Update Football First",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/update-scores-tennis",
        "sendBody": false,
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\"Content-Type\": \"application/json\"}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "update-tennis-first",
      "name": "Update Tennis First",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/internal/validate/predictions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "sport",
              "value": "={{ $('Set Sport').first().json.sport === 'all' ? '' : $('Set Sport').first().json.sport }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\"Content-Type\": \"application/json\", \"X-Internal-Api-Key\": \"__INTERNAL_API_KEY__\"}",
        "jsonBody": {}
      },
      "id": "validate-predictions",
      "name": "Validate Predictions via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst s = data.summary || {};\nconst bySport = s.bySport || {};\nconst byMarket = s.byMarket || {};\nconst byMatch = s.byMatch || {};\n\nlet sportLines = '';\nfor (const [sport, stats] of Object.entries(bySport).sort()) {\n  const acc = stats.validated > 0 ? (stats.successful / stats.validated * 100).toFixed(2) : '0.00';\n  sportLines += `\\n- ${sport}: ${stats.total} predicciones, ${stats.validated} validadas, ${stats.successful} aciertos, ${stats.failed} fallos (${acc}%)`;\n}\n\nlet marketLines = '';\nfor (const [market, stats] of Object.entries(byMarket).sort()) {\n  const acc = stats.validated > 0 ? (stats.successful / stats.validated * 100).toFixed(2) : '0.00';\n  marketLines += `\\n- ${market}: ${stats.successful}/${stats.validated} aciertos (${acc}%)`;\n}\n\nconst matchDistribution = {3: 0, 2: 0, 1: 0, 0: 0};\nconst perfectMatches = [];\nfor (const m of Object.values(byMatch)) {\n  const wins = m.successful || 0;\n  if (matchDistribution[wins] !== undefined) matchDistribution[wins] += 1;\n  if (wins === 3) perfectMatches.push(`${m.homeTeam} vs ${m.awayTeam}`);\n}\nconst matchLines = `\\n- 3/3 aciertos: ${matchDistribution[3]}\\n- 2/3 aciertos: ${matchDistribution[2]}\\n- 1/3 aciertos: ${matchDistribution[1]}\\n- 0/3 aciertos: ${matchDistribution[0]}`;\nconst perfectLine = perfectMatches.length ? `\\n\\nPartidos con 3/3 aciertos (${perfectMatches.length}):\\n- ${perfectMatches.join('\\n- ')}` : '';\n\nconst telegramMessage = `<b>BrainBets - Validacion Real</b>\\n\\nTotal: ${s.total || 0}\\nEmparejadas: ${s.matched || 0}\\nValidadas: ${s.validated || 0}\\nAcertadas: ${s.successful || 0}\\nFallidas: ${s.failed || 0}\\nPendientes: ${s.pending || 0}\\nAccuracy: ${s.accuracy || 0}%${sportLines ? '\\n\\nPor deporte:' + sportLines : ''}${marketLines ? '\\n\\nPor mercado:' + marketLines : ''}\\n\\nPor partido:${matchLines}${perfectLine}`;\nreturn [{\n  json: {\n    generatedAt: data.generatedAt,\n    results: data.results,\n    summary: s,\n    telegramMessage: telegramMessage\n  }\n}];"
      },
      "id": "prepare-db-write",
      "name": "Prepare DB Write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot__TELEGRAM_TOKEN__/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\"Content-Type\": \"application/json\"}",
        "jsonBody": {
          "chat_id": "__TELEGRAM_CHAT_ID__",
          "text": "={{ $json.telegramMessage || 'BrainBets - Validacion completada' }}",
          "parse_mode": "HTML"
        }
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1600,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        450
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-notify",
              "leftValue": "={{ ($json.summary.validated || 0) > 0 ? 'notify' : '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-validated",
      "name": "If Validated",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ]
    }
  ],
  "connections": {
